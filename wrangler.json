{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "les-flambeurs",
  "main": "worker.js",
  "compatibility_date": "2024-11-01",
  "compatibility_flags": [
    "nodejs_compat",
    "nodejs_compat_populate_process_env"
  ],
  "assets": {
    "directory": ".",
    "binding": "ASSETS"
  },
  "durable_objects": {
    "bindings": [
      { "name": "KART", "class_name": "KartRoom" },
      { "name": "GOLF", "class_name": "GolfRoom" },
      { "name": "PROP", "class_name": "PropRoom" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["KartRoom", "GolfRoom"] },
    { "tag": "v2", "new_sqlite_classes": ["PropRoom"] }
  ],
  "keep_vars": true
}
